# Core backend settings
DATABASE_URL=mysql://username:password@host:3306/database_name
JWT_SECRET=replace_with_strong_secret
NODE_ENV=production

# Password reset email settings (SMTP)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="BTM Fibre Connect <no-reply@yourdomain.com>"

# Optional SMTP network timeouts (milliseconds)
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# Resend example:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxx
# MAIL_FROM="BTM Fibre Connect <no-reply@verified-domain.com>"
